# Copy to .env for local overrides. Never commit real secrets.
# Fixture mode needs no API key.

REASONING_RAG_DATA_DIR=data
REASONING_RAG_STORE_DIR=.store
REASONING_RAG_RETRIEVAL_MODE=tree-first
REASONING_RAG_LOG_LEVEL=INFO
REASONING_RAG_LOG_JSON=true
REASONING_RAG_MAX_UPLOAD_BYTES=2000000
REASONING_RAG_MODEL_PROVIDER=fixture
REASONING_RAG_MODEL_NAME=fixture-v0
# REASONING_RAG_MODEL_API_KEY=
REASONING_RAG_TREE_MAX_NODES=500
REASONING_RAG_TREE_MAX_SUMMARIES=64
REASONING_RAG_TREE_SUMMARY_MAX_CHARS=240
REASONING_RAG_RETRIEVE_TOP_K=3
REASONING_RAG_RETRIEVE_MIN_SCORE=0.2
REASONING_RAG_EVIDENCE_MAX_CHARS=1200
REASONING_RAG_PLAN_MAX_DEPTH=6
REASONING_RAG_PLAN_MAX_NODES=3
REASONING_RAG_PLAN_MAX_MODEL_CALLS=0
REASONING_RAG_PLAN_MAX_CONTEXT_TOKENS=4000
